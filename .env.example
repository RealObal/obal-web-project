# Existing public Sanity blog project and dataset.
VITE_SANITY_PROJECT_ID=your_sanity_project_id
VITE_SANITY_DATASET=your_sanity_dataset

# Contact storage uses server-only credentials; see OPERATIONS.md.

# Online contact stays disabled until backend/privacy setup in OPERATIONS.md.
VITE_CONTACT_ENABLED=false
# Server-only settings (never prefix these with VITE_):
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# CONTACT_HASH_SECRET=
# CONTACT_RETENTION_DAYS=90
# CONTACT_PRIVACY_READY=false
# SANITY_WEBHOOK_SECRET=
# VERCEL_DEPLOY_HOOK=
