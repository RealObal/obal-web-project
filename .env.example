# Existing public Sanity blog project and dataset.
VITE_SANITY_PROJECT_ID=your_sanity_project_id
VITE_SANITY_DATASET=your_sanity_dataset

# Existing public Supabase values used by the contact form. Never use a service-role key here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_public_anon_key

# Optional existing build-time prerender switch.
ENABLE_PRERENDER=false
